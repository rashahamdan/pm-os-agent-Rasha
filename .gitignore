# OS / editor cruft
.DS_Store
Thumbs.db
.vscode/
.idea/

# Secrets, never commit API keys or agent credentials
.env
.env.*
!.env.example
*.key
*.pem

# Python
__pycache__/
*.pyc
.venv/

# Agent runtime artifacts you don't want public yet
*.local.json
/traces/
/runs/

# Kill-switch sentinel (touched at runtime to halt a run; never commit it)
KILL_SWITCH
**/KILL_SWITCH
